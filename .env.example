# Copier ce fichier en .env (le .env n'est jamais commité sur Git)
# Valeurs de développement local uniquement.
POSTGRES_DB=dataguard
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=dataguard_dev
POSTGRES_PORT=5433
# « Sel » ajouté avant de hacher les CIN : sans lui, on pourrait retrouver un CIN
# en hachant toutes les combinaisons possibles. En production : un secret long et aléatoire.
DATAGUARD_HASH_SALT=change-moi-en-production
